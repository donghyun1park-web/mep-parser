{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mep-cfd-studio.local/schemas/transient_progress.v1.schema.json",
  "title": "MEP CFD Studio transient_progress.v1",
  "type": "object",
  "required": [
    "schema_version", "contract", "baseline_time_s", "latest_time_s",
    "completed_duration_s", "required_duration_s", "remaining_duration_s",
    "flow_through_time_s", "flow_through_fraction", "runs_completed",
    "total_runtime_seconds", "estimated_remaining_runtime_seconds",
    "recommended_next_duration_s", "interactive_budget_exceeded", "runs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {"const": "transient_progress.v1"},
    "baseline_time_s": {"type": "number"},
    "latest_time_s": {"type": ["number", "null"]},
    "completed_duration_s": {"type": "number", "minimum": 0},
    "required_duration_s": {"type": "number", "exclusiveMinimum": 0},
    "remaining_duration_s": {"type": "number", "minimum": 0},
    "flow_through_fraction": {"type": "number", "minimum": 0},
    "runs_completed": {"type": "integer", "minimum": 1},
    "interactive_budget_exceeded": {"type": "boolean"},
    "last_solver_clock_seconds": {"type": ["number", "null"], "minimum": 0},
    "last_solver_runtime_per_simulated_second": {
      "type": ["number", "null"], "minimum": 0
    },
    "last_fixed_runtime_overhead_seconds": {"type": "number", "minimum": 0},
    "estimated_remaining_runs": {"type": "integer", "minimum": 0},
    "numerics": {
      "type": "object",
      "required": [
        "profile", "outer_correctors", "pressure_correctors",
        "non_orthogonal_correctors", "max_courant", "courant_gate",
        "continuity_gate"
      ]
    },
    "runs": {"type": "array"}
  },
  "additionalProperties": true
}
