{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io_acceptance.v1.schema.json",
  "title": "MEP CFD Studio filesystem and recovered-artifact acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "created_at", "projects_root", "roots", "status", "probes", "inventory_path", "inventory_sha256", "artifact_probes"],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {"const": "io_acceptance.v1"},
    "created_at": {"type": "string"},
    "projects_root": {"type": "string"},
    "roots": {"type": "array", "minItems": 6, "items": {"type": "string"}},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "probes": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/root_probe"}},
    "inventory_path": {"type": "string", "minLength": 1},
    "inventory_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "artifact_probes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_probe"}}
  },
  "$defs": {
    "root_probe": {
      "type": "object",
      "required": ["path", "read", "create", "replace", "delete", "status", "error_code"],
      "properties": {
        "path": {"type": "string"}, "read": {"type": "boolean"}, "create": {"type": "boolean"},
        "replace": {"type": "boolean"}, "delete": {"type": "boolean"},
        "status": {"enum": ["PASS", "BLOCKED"]}, "error_code": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "artifact_probe": {
      "type": "object",
      "required": ["case", "kind", "path", "read", "sha256", "status", "error_code"],
      "properties": {
        "case": {"type": ["string", "null"]}, "kind": {"type": "string"}, "path": {"type": ["string", "null"]},
        "read": {"type": "boolean"}, "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "status": {"enum": ["PASS", "BLOCKED"]}, "error_code": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
