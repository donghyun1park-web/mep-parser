{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io_acceptance.v1.schema.json",
  "title": "MEP CFD Studio filesystem acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "created_at", "projects_root", "roots", "status", "probes"],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {"const": "io_acceptance.v1"},
    "created_at": {"type": "string"},
    "projects_root": {"type": "string"},
    "roots": {"type": "array", "minItems": 6, "items": {"type": "string"}},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "probes": {"type": "array", "minItems": 6, "items": {"type": "object", "required": ["path", "read", "create", "replace", "delete", "status"], "properties": {"path": {"type": "string"}, "read": {"type": "boolean"}, "create": {"type": "boolean"}, "replace": {"type": "boolean"}, "delete": {"type": "boolean"}, "status": {"enum": ["PASS", "BLOCKED"]}, "error_code": {"type": ["string", "null"]}}}}
  }
}
