{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temporal_sensitivity.v1.schema.json",
  "title": "MEP CFD temporal sensitivity input and verified result contract",
  "oneOf": [
    {"$ref": "#/$defs/pending"},
    {"$ref": "#/$defs/result"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "controller": {
      "type": "object", "additionalProperties": false,
      "required": ["adjust_time_step", "max_co", "limiter_policy"],
      "properties": {
        "adjust_time_step": {"const": false},
        "max_co": {"const": 1.0},
        "limiter_policy": {"const": "fixed_delta_t_no_controller_intervention.v1"}
      }
    },
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["anchor_id", "role", "path", "sha256", "binding_sha256"],
      "properties": {
        "anchor_id": {"type": "string", "pattern": "^anchor-[0-9a-f]{16}$"},
        "role": {"const": "temporal_fine"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pendingChild": {
      "type": "object", "additionalProperties": false,
      "required": ["case_child", "delta_t_s", "adjust_time_step", "case_seed_tree_sha256", "solver_evidence_status"],
      "properties": {
        "case_child": {"type": "string", "enum": ["coarse_dt_0p04", "medium_dt_0p02", "fine_dt_0p01"]},
        "delta_t_s": {"type": "number", "exclusiveMinimum": 0},
        "adjust_time_step": {"const": false},
        "case_seed_tree_sha256": {"$ref": "#/$defs/sha256"},
        "solver_evidence_status": {"const": "PENDING_SOLVER_EVIDENCE"}
      }
    },
    "pending": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "status", "seed_case_path", "seed_tree_sha256", "anchor_fine_case", "fixed_delta_t_s", "controller", "children", "allowed_variation", "evidence_requirements", "manifest_sha256"],
      "properties": {
        "contract": {"const": "temporal_sensitivity.v1"},
        "status": {"const": "PENDING_SOLVER_EVIDENCE"},
        "seed_case_path": {"type": "string", "minLength": 1},
        "seed_tree_sha256": {"$ref": "#/$defs/sha256"},
        "anchor_fine_case": {"type": ["string", "null"]},
        "validation_anchor": {"$ref": "#/$defs/anchor"},
        "selector": {"type": "object"},
        "fixed_delta_t_s": {"const": [0.04, 0.02, 0.01]},
        "controller": {"$ref": "#/$defs/controller"},
        "children": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/pendingChild"}, {"properties": {"case_child": {"const": "coarse_dt_0p04"}, "delta_t_s": {"const": 0.04}}}]},
            {"allOf": [{"$ref": "#/$defs/pendingChild"}, {"properties": {"case_child": {"const": "medium_dt_0p02"}, "delta_t_s": {"const": 0.02}}}]},
            {"allOf": [{"$ref": "#/$defs/pendingChild"}, {"properties": {"case_child": {"const": "fine_dt_0p01"}, "delta_t_s": {"const": 0.01}}}]}
          ],
          "items": false
        },
        "allowed_variation": {
          "type": "object", "additionalProperties": false,
          "required": ["parameter", "baseline", "medium", "fine", "all_other_inputs_equal"],
          "properties": {
            "parameter": {"const": "delta_t_s"},
            "baseline": {"const": 0.04},
            "medium": {"const": 0.02},
            "fine": {"const": 0.01},
            "all_other_inputs_equal": {"const": true}
          }
        },
        "evidence_requirements": {
          "type": "object", "additionalProperties": false,
          "required": ["minimum_flow_through_time_s", "common_final_window_s", "peak_co_limit", "requires_time_history", "requires_qoi_recomputation"],
          "properties": {
            "minimum_flow_through_time_s": {"const": 3.0},
            "common_final_window_s": {"const": 0.1},
            "peak_co_limit": {"const": 1.0},
            "requires_time_history": {"const": true},
            "requires_qoi_recomputation": {"const": true}
          }
        },
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "timeHistory": {
      "type": "object", "additionalProperties": false,
      "required": ["valid", "expected_delta_t_s", "sample_count", "minimum_delta_t_s", "maximum_delta_t_s", "first_time_s", "last_time_s", "source_logs", "blockers"],
      "properties": {
        "valid": {"const": true},
        "expected_delta_t_s": {"type": "number", "exclusiveMinimum": 0},
        "sample_count": {"type": "integer", "minimum": 1},
        "minimum_delta_t_s": {"type": "number", "exclusiveMinimum": 0},
        "maximum_delta_t_s": {"type": "number", "exclusiveMinimum": 0},
        "first_time_s": {"type": "number", "exclusiveMinimum": 0},
        "last_time_s": {"type": "number", "exclusiveMinimum": 0},
        "source_logs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "blockers": {"const": []}
      }
    },
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["start_s", "end_s", "flow_through_fraction_start", "flow_through_fraction_end"],
      "properties": {
        "start_s": {"type": "number", "minimum": 0},
        "end_s": {"type": "number", "exclusiveMinimum": 0},
        "flow_through_fraction_start": {"type": "number", "minimum": 0},
        "flow_through_fraction_end": {"type": "number", "minimum": 3.0}
      }
    },
    "qois": {
      "type": "object", "additionalProperties": false,
      "required": ["occupied_zone_mean_temperature_k", "occupied_zone_mean_speed_m_s", "exhaust_temperature_rise_k"],
      "properties": {
        "occupied_zone_mean_temperature_k": {"type": "number"},
        "occupied_zone_mean_speed_m_s": {"type": "number", "minimum": 0},
        "exhaust_temperature_rise_k": {"type": "number"}
      }
    },
    "verifiedChild": {
      "type": "object", "additionalProperties": false,
      "required": ["case_child", "delta_t_s", "case_path", "run_hash", "result_hash", "mesh_hash", "solver_log_tree_sha256", "time_history", "window", "qois", "solver_evidence"],
      "properties": {
        "case_child": {"type": "string", "enum": ["coarse_dt_0p04", "medium_dt_0p02", "fine_dt_0p01"]},
        "delta_t_s": {"type": "number", "exclusiveMinimum": 0},
        "case_path": {"type": "string", "minLength": 1},
        "run_hash": {"$ref": "#/$defs/sha256"},
        "result_hash": {"$ref": "#/$defs/sha256"},
        "mesh_hash": {"$ref": "#/$defs/sha256"},
        "solver_log_tree_sha256": {"$ref": "#/$defs/sha256"},
        "time_history": {"$ref": "#/$defs/timeHistory"},
        "window": {"$ref": "#/$defs/window"},
        "qois": {"$ref": "#/$defs/qois"},
        "solver_evidence": {"type": "object"}
      }
    },
    "convergence": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "coarse", "medium", "fine", "fixed_delta_t_s", "refinement_ratios", "convergence", "observed_order", "extrapolated", "safety_factor", "uncertainty_fine", "uncertainty_fine_pct", "relative_limit_pct", "medium_fine_absolute_difference", "absolute_limit", "asymptotic_ratio", "status", "blockers"],
      "properties": {
        "name": {"type": "string", "enum": ["occupied_zone_mean_temperature_k", "occupied_zone_mean_speed_m_s", "exhaust_temperature_rise_k"]},
        "coarse": {"type": "number"},
        "medium": {"type": "number"},
        "fine": {"type": "number"},
        "fixed_delta_t_s": {"const": [0.04, 0.02, 0.01]},
        "refinement_ratios": {"const": [2.0, 2.0]},
        "convergence": {"const": "monotonic"},
        "observed_order": {"type": "number", "minimum": 0.5, "maximum": 1.5},
        "extrapolated": {"type": "number"},
        "safety_factor": {"const": 1.25},
        "uncertainty_fine": {"type": "number", "minimum": 0},
        "uncertainty_fine_pct": {"type": "number", "minimum": 0, "maximum": 5.0},
        "relative_limit_pct": {"const": 5.0},
        "medium_fine_absolute_difference": {"type": "number", "minimum": 0},
        "absolute_limit": {"type": "number", "exclusiveMinimum": 0},
        "asymptotic_ratio": {"type": "number", "minimum": 0.8, "maximum": 1.2},
        "status": {"const": "PASS"},
        "blockers": {"const": []}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "verifier", "raw_artifacts_rehashed", "study_root", "evidence_path", "evidence_sha256", "plot_path", "plot_sha256"],
      "properties": {
        "contract": {"const": "temporal_sensitivity_verification.v1"},
        "verifier": {"const": "run_temporal_sensitivity.verify_temporal_study"},
        "raw_artifacts_rehashed": {"const": true},
        "study_root": {"type": "string", "minLength": 1},
        "evidence_path": {"const": "temporal_sensitivity_verification.v1.json"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "plot_path": {"const": "temporal_sensitivity_convergence.v1.svg"},
        "plot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "status", "study_root", "current_case", "fixed_delta_t_s", "controller", "manifest_sha256", "preparation_sha256", "execution_checkpoint_sha256", "children", "qoi_convergence", "blockers", "verification"],
      "properties": {
        "contract": {"const": "temporal_sensitivity.v1"},
        "status": {"const": "PASS"},
        "study_root": {"type": "string", "minLength": 1},
        "current_case": {"type": "string", "minLength": 1},
        "fixed_delta_t_s": {"const": [0.04, 0.02, 0.01]},
        "controller": {"$ref": "#/$defs/controller"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "preparation_sha256": {"$ref": "#/$defs/sha256"},
        "execution_checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "children": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/verifiedChild"}},
        "qoi_convergence": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/convergence"}},
        "blockers": {"const": []},
        "verification": {"$ref": "#/$defs/verification"},
        "validation_anchor": {"$ref": "#/$defs/anchor"}
      }
    }
  }
}
