{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mep-cfd-studio.local/schemas/surface_manifest.v1.schema.json",
  "title": "MEP CFD Studio surface_manifest.v1",
  "type": "object",
  "required": [
    "schema_version", "contract", "engine", "source", "tools", "transform",
    "tessellation", "air_volume", "regions", "topology", "outputs", "surface_hash"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {"const": "surface_manifest.v1"},
    "engine": {"const": "body_fitted_airflow"},
    "source": {
      "type": "object",
      "required": ["geometry_path", "geometry_sha256", "geometry_contract", "space_element_id"]
    },
    "tools": {
      "type": "object",
      "required": ["freecad", "occ", "python"]
    },
    "transform": {
      "type": "object",
      "required": ["occ_units", "stl_units", "scale", "origin_mm", "rotation_deg", "inverse"],
      "properties": {
        "occ_units": {"const": "mm"},
        "stl_units": {"const": "m"},
        "scale": {"const": 0.001}
      }
    },
    "air_volume": {
      "type": "object",
      "required": [
        "valid", "solid_count", "volume_m3", "boundary_area_m2", "region_area_m2",
        "area_error_ratio", "obstacle_count", "location_in_mesh"
      ],
      "properties": {
        "valid": {"const": true},
        "solid_count": {"const": 1},
        "volume_m3": {"type": "number", "exclusiveMinimum": 0},
        "area_error_ratio": {"type": "number", "maximum": 0.001}
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name", "role", "source_element_ids", "area_m2", "aabb",
          "triangle_count", "normalized_triangle_hash"
        ],
        "properties": {
          "airflow_cmh": {"type": "number", "exclusiveMinimum": 0},
          "power_kw": {"type": "number", "exclusiveMinimum": 0},
          "input_power_w": {"type": "number", "exclusiveMinimum": 0},
          "convective_fraction": {
            "type": "number", "exclusiveMinimum": 0, "maximum": 1
          },
          "radiative_fraction": {
            "type": "number", "minimum": 0, "maximum": 1
          },
          "convective_power_w": {"type": "number", "minimum": 0},
          "radiative_power_w": {"type": "number", "minimum": 0},
          "excluded_radiative_power_w": {"type": "number", "minimum": 0},
          "source_id": {"type": "string", "minLength": 1},
          "source_label": {"type": "string", "minLength": 1},
          "source_ref": {"type": "object", "minProperties": 1},
          "override_of_dxf": {"type": "boolean"},
          "evidence": {"type": "string", "minLength": 1},
          "source_type": {"type": "string", "minLength": 1},
          "design_normal": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": {"type": "number"}
          }
        },
        "allOf": [{
          "if": {
            "required": ["role"],
            "properties": {"role": {"const": "heat_source"}}
          },
          "then": {
            "required": [
              "power_kw", "input_power_w", "convective_fraction",
              "radiative_fraction", "convective_power_w", "radiative_power_w",
              "excluded_radiative_power_w", "source_id", "source_label",
              "source_ref", "evidence", "source_type"
            ]
          }
        }]
      }
    },
    "topology": {
      "type": "object",
      "required": ["open_edges", "non_manifold_edges", "duplicate_triangles", "watertight"],
      "properties": {
        "open_edges": {"const": 0},
        "non_manifold_edges": {"const": 0},
        "duplicate_triangles": {"const": 0},
        "watertight": {"const": true}
      }
    },
    "surface_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
