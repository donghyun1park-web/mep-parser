{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mep-cfd-studio.local/schemas/result_manifest.v1.schema.json",
  "title": "MEP CFD Studio result_manifest.v1",
  "type": "object",
  "required": [
    "schema_version", "contract", "engine", "created_at", "time_s",
    "source", "field_location", "fields", "summary_path", "summary_sha256", "slices"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {"const": "result_manifest.v1"},
    "engine": {"const": "body_fitted_openfoam_vtu"},
    "time_s": {"type": ["number", "null"]},
    "field_location": {"const": "cell"},
    "source": {
      "type": "object",
      "required": ["path", "sha256", "format"]
    },
    "summary_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "thermal_input_sha256": {"type": ["string", "null"], "minLength": 64, "maxLength": 64},
    "fields": {"type": "object", "required": ["T", "U"]},
    "slices": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object",
        "required": ["axis", "path", "sha256"],
        "properties": {
          "axis": {"enum": ["x", "y", "z"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "minLength": 64, "maxLength": 64}
        }
      }
    },
    "occupied_qoi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "selector_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selector_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "additionalProperties": true
}
