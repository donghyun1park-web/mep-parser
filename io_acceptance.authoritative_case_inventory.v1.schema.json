{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io_acceptance.authoritative_case_inventory.v1.schema.json",
  "title": "MEP CFD Studio authoritative recovered case inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "created_at", "cases"],
  "properties": {
    "contract": {"const": "io_authoritative_case_inventory.v1"},
    "created_at": {"type": "string"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "contract": {"type": "string", "minLength": 1}}
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "case_path", "mesh_manifest", "run_manifest", "result_manifest", "check_mesh_log", "solver_log", "latest_time", "fields", "vtu", "html"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1}, "case_path": {"type": "string", "pattern": "^_body_solver/.+"},
        "mesh_manifest": {"$ref": "#/$defs/link"}, "run_manifest": {"$ref": "#/$defs/link"}, "result_manifest": {"$ref": "#/$defs/link"},
        "check_mesh_log": {"$ref": "#/$defs/link"}, "solver_log": {"$ref": "#/$defs/link"}, "latest_time": {"type": "string", "minLength": 1},
        "fields": {"type": "object", "additionalProperties": false, "required": ["T", "U", "phi", "V"], "properties": {"T": {"$ref": "#/$defs/link"}, "U": {"$ref": "#/$defs/link"}, "phi": {"$ref": "#/$defs/link"}, "V": {"$ref": "#/$defs/link"}}},
        "vtu": {"$ref": "#/$defs/link"}, "html": {"$ref": "#/$defs/link"}
      }
    }
  }
}
